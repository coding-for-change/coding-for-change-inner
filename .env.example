# Payload CMS
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_MIN_32_CHARS
DATABASE_URL=postgresql://payload:payload@postgres:5432/payload


RESEND_API_KEY=
EMAIL_FROM=noreply@codingforchange.com
EMAIL_FROM_NAME=Coding for Change
# Fallback recipient for form submissions that don't define their own emails.
CONTACT_TO_EMAIL=info@codingforchange.com

# Analytics behavioural-event retention, in months. The CMS auto-purges
# analytics-events older than this (on boot + daily). Default 12. Set to 0 to
# disable the built-in purge (e.g. if you run an external cron instead).
# Note: this only affects the analytics-events table — never waitlist signups
# or form submissions, which keep their own retention.
ANALYTICS_RETENTION_MONTHS=12
